# CRAFT ENVIRONMENT
.env.php
.env.sh
.env

# COMPOSER
/vendor
# A plugin is a library: consumers resolve against their own project's lock, so
# ours would only pin the author's dev tree. Tracking it also feeds every
# transitive CVE in that tree to Dependabot as if it were the plugin's
# dependency surface. Reproducibility lives in composer.json's constraints.
/composer.lock

# BUILD FILES
/bower_components/*
/node_modules/*
/build/*
/yarn-error.log

# MISC FILES
.cache
.DS_Store
.idea
.project
.settings
*.esproj
*.sublime-workspace
*.sublime-project
*.tmproj
*.tmproject
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
config.codekit3
prepros-6.config

# LOCAL TOOLING
/.claude/
/CLAUDE.md

