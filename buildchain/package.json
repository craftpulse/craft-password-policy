{
  "name": "buildchain",
  "description": "A drop-in buildchain for using Vite in your Craft CMS plugins or modules",
  "author": {
    "email": "info@nystudio107.com",
    "name": "nystudio107",
    "url": "https://nystudio107.com"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.0.0",
    "postcss": "^8.4.0",
    "rollup-plugin-visualizer": "^7.0.0",
    "stylelint": "^14.0.0",
    "stylelint-config-recommended": "^6.0.0",
    "stylelint-config-standard-scss": "^3.0.0",
    "tailwindcss": "^3.0.0",
    "typescript": "~5.9.0",
    "vite": "^6.0.0",
    "vite-plugin-compression": "^0.5.0",
    "vite-plugin-eslint2": "^5.0.0",
    "vite-plugin-restart": "^2.0.0",
    "vite-plugin-stylelint": "^6.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run lint && vite build",
    "lint": "npm run lint:ts && npm run lint:js && npm run lint:css",
    "lint:ts": "tsc --noEmit",
    "lint:js": "eslint './src/**/*.{js,ts}' --fix",
    "lint:css": "stylelint './src/**/*.css' --fix"
  }
}
