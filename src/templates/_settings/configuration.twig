{% requirePermission "pp:settings" %}

{% extends "password-policy/_layouts/password-policy-cp-settings.twig" %}
{% import '_includes/forms.twig' as forms %}

{% set selectedItem = 'configuration' %}
{% set title = 'Configuration'|t('password-policy') %}

{% block actionButton %}
    {% if not readOnly %}
        <input type="submit" class="btn submit" value="{{ 'Save'|t('app') }}">
    {% endif %}
{% endblock %}

{% block content %}
    <input type="hidden" name="action" value="password-policy/settings/save">
    <input type="hidden" name="pluginHandle" value="password-policy">
    {{ redirectInput('password-policy/settings/configuration') }}

    <div class="flex-fields">
        {% set hibpInfo %}
            <span class="info">{{ "Uses the k-Anonymity model: only the first 5 characters of the SHA-1 hash are sent to the HIBP API. The full password never leaves your server. Checks against over 800 million compromised passwords from known data breaches."|t('password-policy') }}</span>
        {% endset %}
        {{ forms.lightswitchField({
            label: 'Enable "Have I Been Pwned"'|t('password-policy'),
            instructions: "Check passwords against the HIBP breach database."|t('password-policy') ~ hibpInfo,
            name: 'settings[hibp]',
            on: settings.hibp,
            disabled: readOnly,
        }) }}

        {% set failModeInfo %}
            <span class="info">{{ "Fail-open accepts the password when the API is unreachable — prioritizes availability. Fail-closed rejects it — prioritizes security but may block all password changes during an outage. Most organizations should use fail-open unless compliance requires otherwise."|t('password-policy') }}</span>
        {% endset %}
        {{ forms.selectField({
            label: 'HIBP Failure Mode'|t('password-policy'),
            instructions: "What happens when the HIBP API is unreachable."|t('password-policy') ~ failModeInfo,
            name: 'settings[hibpFailMode]',
            id: 'hibpFailMode',
            options: [
                { label: 'Fail-open (accept password)'|t('password-policy'), value: 'open' },
                { label: 'Fail-closed (reject password)'|t('password-policy'), value: 'closed' },
            ],
            value: settings.hibpFailMode,
            disabled: readOnly,
        }) }}

        <p id="hibpFailMode-warning" class="warning has-icon" {% if settings.hibpFailMode != 'closed' %}style="display:none"{% endif %}>
            <span class="icon" aria-hidden="true"></span>
            <span class="visually-hidden">{{ "Warning:"|t('app') }} </span>
            <span>{{ "Fail-closed will block ALL password changes when the HIBP API is unreachable."|t('password-policy') }}</span>
        </p>

        {% js %}
            document.getElementById('hibpFailMode').addEventListener('change', function() {
                document.getElementById('hibpFailMode-warning').style.display =
                    this.value === 'closed' ? '' : 'none';
            });
        {% endjs %}

        {% if craft.app.plugins.getPlugin('password-policy').getIsPro() %}
            <hr>

            {% set hibpLoginInfo %}
                <span class="info">{{ "Re-checks the user's password against the HIBP breach database every time they sign in. If a match is found, the user is forced to reset their password on the next sign-in and receives a notification email. Login is never blocked. Same k-anonymity model as HIBP-at-change-time — only the SHA-1 prefix leaves your server."|t('password-policy') }}</span>
            {% endset %}
            {{ forms.lightswitchField({
                label: 'Re-check passwords against HIBP on login (Pro)'|t('password-policy'),
                instructions: "Detect when a user's existing password leaks into a public breach after they last changed it."|t('password-policy') ~ hibpLoginInfo,
                name: 'settings[enableHibpOnLogin]',
                on: settings.enableHibpOnLogin,
                disabled: readOnly,
            }) }}
        {% endif %}

        <hr>

        {{ forms.lightswitchField({
            label: 'Show password strength indicator'|t('password-policy'),
            instructions: "Display a password strength meter on control panel password fields. Shares the same engine as the front-end Twig builders, so the blocklist, per-group policy resolution, and the strength engine selected below all surface here too."|t('password-policy'),
            name: 'settings[showStrengthIndicator]',
            on: settings.showStrengthIndicator,
            disabled: readOnly,
        }) }}

        {% if craft.app.plugins.getPlugin('password-policy').getIsPro() %}
            {% set strengthEngineInfo %}
                <span class="info">{{ "When off, the meter scores passwords by counting policy rule satisfaction. When on, the bundled zxcvbn engine produces materially better strength estimates plus per-password suggestions, at the cost of ~200KB of additional dictionary payload sent to clients running the front-end builders."|t('password-policy') }}</span>
            {% endset %}
            {{ forms.lightswitchField({
                label: 'Use zxcvbn strength engine (Pro)'|t('password-policy'),
                instructions: "Score password strength via the zxcvbn dictionary engine instead of the rule-counting baseline."|t('password-policy') ~ strengthEngineInfo,
                name: 'settings[useZxcvbnStrength]',
                on: settings.useZxcvbnStrength,
                disabled: readOnly,
            }) }}
        {% endif %}

        <hr>

        {% set forceChangeInfo %}
            <span class="info">{{ "Newly created users will have passwordResetRequired set automatically. They will be prompted to change their password immediately after first login, ensuring admin-assigned initial passwords are replaced."|t('password-policy') }}</span>
        {% endset %}
        {{ forms.lightswitchField({
            label: 'Force change on first login'|t('password-policy'),
            instructions: "Require new users to change their password on first login."|t('password-policy') ~ forceChangeInfo,
            name: 'settings[forceChangeOnFirstLogin]',
            on: settings.forceChangeOnFirstLogin,
            disabled: readOnly,
        }) }}

        <hr>

        {{ forms.lightswitchField({
            label: 'Enable CSP Nonce'|t('password-policy'),
            instructions: 'Generates a Content Security Policy nonce for the password indicator script.'|t('password-policy'),
            name: 'settings[cspNonce]',
            on: settings.cspNonce,
            tip: 'Only enable if you have a strict CSP policy requiring nonces for external scripts.'|t('password-policy'),
            disabled: readOnly,
        }) }}
    </div>
{% endblock %}
