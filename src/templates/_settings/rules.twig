{% requirePermission "pp:manage-settings" %}

{% extends "password-policy/_layouts/password-policy-cp-settings.twig" %}
{% import '_includes/forms.twig' as forms %}

{% set selectedItem = 'rules' %}
{% set title = 'Password Rules'|t('password-policy') %}

{% block actionButton %}
    {% if not readOnly %}
        <input type="submit" class="btn submit" value="{{ 'Save'|t('app') }}">
    {% endif %}
{% endblock %}

{% block content %}
    <input type="hidden" name="action" value="password-policy/settings/save">
    <input type="hidden" name="pluginHandle" value="password-policy">
    {{ redirectInput('password-policy/settings/rules') }}

    <div class="flex-fields">
        {% set minLengthInfo %}
            <span class="info">{{ "NIST SP 800-63B Rev. 4 recommends a minimum of 15 characters for single-factor auth. Anything below 12 reads as out of date in modern compliance reviews."|t('password-policy') }}</span>
        {% endset %}
        {{ forms.autosuggestField({
            label: 'Minimum password length'|t('password-policy'),
            instructions: "The minimum number of characters a password must have. Cannot be less than 6."|t('password-policy') ~ minLengthInfo,
            name: 'settings[minLength]',
            suggestEnvVars: true,
            value: settings.minLength,
            required: true,
            disabled: readOnly,
        }) }}

        {% set maxLengthInfo %}
            <span class="info">{{ "NIST recommends supporting at least 64 characters. Setting a maximum is generally discouraged unless required for compatibility. A value of 0 means no maximum."|t('password-policy') }}</span>
        {% endset %}
        {{ forms.autosuggestField({
            label: 'Maximum password length'|t('password-policy'),
            instructions: "The maximum number of characters allowed. Set to 0 for no limit."|t('password-policy') ~ maxLengthInfo,
            name: 'settings[maxLength]',
            suggestEnvVars: true,
            value: settings.maxLength,
            disabled: readOnly,
        }) }}

        <hr>

        {# Complexity Mode is a Pro feature — omitted entirely on Lite, which
           always runs the individual toggles below (no mode selector, no
           locked/badged upsell row). #}
        {% if isPro %}
            {% set complexityInfo %}
                <span class="info">{{ "Individual toggles lets you require specific character types independently, best when your policy mandates exact requirements. Minimum character types requires at least X of 4 types, giving users flexibility. This is the NIST-recommended approach as it encourages diversity without overly prescriptive rules."|t('password-policy') }}</span>
            {% endset %}
            {{ forms.selectField({
                label: 'Complexity mode'|t('password-policy'),
                instructions: "How password complexity is enforced."|t('password-policy') ~ complexityInfo,
                name: 'settings[complexityMode]',
                options: [
                    { label: 'Individual toggles'|t('password-policy'), value: 'individual' },
                    { label: 'Minimum character types'|t('password-policy'), value: 'minimum' },
                ],
                value: settings.complexityMode,
                toggle: true,
                targetPrefix: 'complexity-',
                disabled: readOnly,
            }) }}
        {% endif %}

        <div id="complexity-individual" {% if isPro and settings.complexityMode == 'minimum' %}class="hidden"{% endif %}>
            {{ forms.lightswitchField({
                label: 'Require numbers'|t('password-policy'),
                instructions: "Password must contain at least one number."|t('password-policy'),
                name: 'settings[numbers]',
                on: settings.numbers,
                disabled: readOnly,
            }) }}

            {{ forms.lightswitchField({
                label: 'Require mixed case'|t('password-policy'),
                instructions: "Password must contain both uppercase and lowercase letters."|t('password-policy'),
                name: 'settings[cases]',
                on: settings.cases,
                disabled: readOnly,
            }) }}

            {{ forms.lightswitchField({
                label: 'Require symbols'|t('password-policy'),
                instructions: "Password must contain at least one special character."|t('password-policy'),
                name: 'settings[symbols]',
                on: settings.symbols,
                disabled: readOnly,
            }) }}
        </div>

        {% if isPro %}
            <div id="complexity-minimum" {% if settings.complexityMode != 'minimum' %}class="hidden"{% endif %}>
                {% set charTypesInfo %}
                    <span class="info">{{ "The 4 character types are: uppercase letters (A-Z), lowercase letters (a-z), numbers (0-9), and symbols (!@#$%^&* etc.). Requiring 3 of 4 is a strong baseline that balances security with usability."|t('password-policy') }}</span>
                {% endset %}
                {{ forms.selectField({
                    label: 'Minimum character types required'|t('password-policy'),
                    instructions: "The password must contain at least this many of the 4 character types."|t('password-policy') ~ charTypesInfo,
                    name: 'settings[minimumCharacterTypes]',
                    options: [
                        { label: '2 of 4', value: 2 },
                        { label: '3 of 4', value: 3 },
                        { label: '4 of 4', value: 4 },
                    ],
                    value: settings.minimumCharacterTypes,
                    disabled: readOnly,
                }) }}
            </div>
        {% endif %}
    </div>
{% endblock %}
