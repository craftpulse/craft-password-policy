{# Group policies settings — toggle + link to named policies manager #}
{# @var settings \craftpulse\passwordpolicy\models\SettingsModel #}
{# @var readOnly bool #}
{# @var isPro bool #}

{% requirePermission "pp:settings" %}

{% extends "password-policy/_layouts/password-policy-cp-settings.twig" %}
{% import '_includes/forms.twig' as forms %}

{% set selectedItem = 'groups' %}
{% set title = 'Group Policies'|t('password-policy') %}
{% set editionLocked = not isPro %}

{% block actionButton %}
    {% if not readOnly and not editionLocked %}
        <input type="submit" class="btn submit" value="{{ 'Save'|t('app') }}">
    {% endif %}
{% endblock %}

{% block content %}
    <input type="hidden" name="action" value="password-policy/settings/save">
    <input type="hidden" name="pluginHandle" value="password-policy">
    {{ redirectInput('password-policy/settings/groups') }}

    {% if editionLocked %}
        {% include "password-policy/_components/edition-gate" with { edition: 'Pro' } %}
    {% endif %}

    {% set perGroupInfo %}
        <span class="info">{{ "When a user belongs to multiple groups, each setting is resolved independently using \"most restrictive wins\" logic. Boolean checks can only be strengthened (enabled), never weakened. Numeric minimums take the highest value, numeric maximums take the lowest."|t('password-policy') }}</span>
    {% endset %}
    {{ forms.lightswitchField({
        label: 'Enable per-group policies'|t('password-policy'),
        instructions: "Override password policy settings per user group."|t('password-policy') ~ perGroupInfo,
        id: 'enablePerGroupPolicies',
        name: 'settings[enablePerGroupPolicies]',
        on: settings.enablePerGroupPolicies,
        disabled: readOnly or editionLocked,
        toggle: '#group-policies-container',
    }) }}

    <div id="group-policies-container" {% if not settings.enablePerGroupPolicies %}class="hidden"{% endif %}>
        <hr>

        {% set policyService = craft.app.plugins.getPlugin('password-policy').getPolicies() %}
        {% set policyCount = policyService.getAllPolicies()|length %}

        {% if policyCount > 0 %}
            <p class="light">{{ "{count, number} {count, plural, =1{policy} other{policies}} configured. Each policy can be assigned to one or more user groups."|t('password-policy', { count: policyCount }) }}</p>
        {% else %}
            <p class="light">{{ "No policies have been created yet. Create policies to override the global password rules for specific user groups."|t('password-policy') }}</p>
        {% endif %}

        <p>
            <a class="btn go" href="{{ cpUrl('password-policy/policies') }}">{{ "Manage policies"|t('password-policy') }}</a>
        </p>
    </div>
{% endblock %}
