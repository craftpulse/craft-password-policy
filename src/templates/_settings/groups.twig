{% requirePermission "pp:settings" %}

{% extends "password-policy/_layouts/password-policy-cp-settings.twig" %}
{% import '_includes/forms.twig' as forms %}

{% set selectedItem = 'groups' %}
{% set title = 'Group Policies'|t('password-policy') %}
{% set editionLocked = not isPro %}

{% block actionButton %}
    {% if not readOnly and not editionLocked %}
        <input type="submit" class="btn submit" value="{{ 'Save'|t('app') }}">
    {% endif %}
{% endblock %}

{% block content %}
    <input type="hidden" name="action" value="password-policy/settings/save">
    <input type="hidden" name="pluginHandle" value="password-policy">
    {{ redirectInput('password-policy/settings/groups') }}

    {% if editionLocked %}
        {% include "password-policy/_components/edition-gate" with { edition: 'Pro' } %}
    {% endif %}

    <div class="flex-fields">
        {{ forms.lightswitchField({
            label: 'Enable per-group policies'|t('password-policy'),
            instructions: "Override password policy settings per user group. When a user belongs to multiple groups, the most restrictive value for each setting is applied."|t('password-policy'),
            name: 'settings[enablePerGroupPolicies]',
            on: settings.enablePerGroupPolicies,
            disabled: readOnly or editionLocked,
        }) }}

        {% if settings.enablePerGroupPolicies and not editionLocked %}
            <div class="readable">
                <blockquote class="note tip">
                    <p>{{ "Per-group policy configuration UI coming in a future release. Configure via config/password-policy.php or project config."|t('password-policy') }}</p>
                </blockquote>
            </div>
        {% endif %}
    </div>
{% endblock %}
