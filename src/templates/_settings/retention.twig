{% requirePermission "pp:settings" %}

{% extends "password-policy/_layouts/password-policy-cp-settings.twig" %}
{% import '_includes/forms.twig' as forms %}

{% set selectedItem = 'retention' %}
{% set title = 'Password Retention'|t('password-policy') %}

{% block actionButton %}
    {% if not readOnly %}
        <input type="submit" class="btn submit" value="{{ 'Save'|t('app') }}">
    {% endif %}
{% endblock %}

{% block content %}
    <input type="hidden" name="action" value="password-policy/settings/save">
    <input type="hidden" name="pluginHandle" value="password-policy">
    {{ redirectInput('password-policy/settings/retention') }}

    <div class="flex-fields">
        {% set retentionInfo %}
            <span class="info">{{ "Adds a utility under Utilities in the CP that lets admins force-reset passwords for users whose passwords have expired. Useful for compliance audits and periodic security reviews."|t('password-policy') }}</span>
        {% endset %}
        {{ forms.lightswitchField({
            label: 'Enable retention utilities'|t('password-policy'),
            instructions: "Show the password retention utility in the CP for force-resetting expired passwords."|t('password-policy') ~ retentionInfo,
            name: 'settings[retentionUtilities]',
            on: settings.retentionUtilities,
            disabled: readOnly,
        }) }}

        <hr>

        {% set expiryInfo %}
            <span class="info">{{ "NIST 800-63B and OWASP ASVS recommend against periodic rotation. PCI-DSS v4.0 still requires 90-day rotation. If your organization must comply with conflicting frameworks, document the trade-off in your security policy."|t('password-policy') }}</span>
        {% endset %}
        {%- set expiryInput %}
            <div class="flex">
                <div>
                    {{ forms.text({
                        class: 'ltr',
                        name: 'settings[expiryAmount]',
                        type: 'number',
                        value: settings.expiryAmount,
                        disabled: readOnly,
                        inputAttributes: { style: 'width: 5rem' },
                    }) }}
                </div>
                <div>
                    {{ forms.select({
                        name: 'settings[expiryPeriod]',
                        options: [
                            { label: 'Day(s)'|t('password-policy'), value: 'day' },
                            { label: 'Week(s)'|t('password-policy'), value: 'week' },
                            { label: 'Month(s)'|t('password-policy'), value: 'month' },
                            { label: 'Year(s)'|t('password-policy'), value: 'year' },
                        ],
                        value: settings.expiryPeriod,
                        disabled: readOnly,
                    }) }}
                </div>
            </div>
        {%- endset -%}

        {{ forms.field({
            label: "Expiry period"|t('password-policy'),
            instructions: "How long until passwords expire. Leave empty to disable expiration."|t('password-policy') ~ expiryInfo,
            id: 'expiryInput',
        }, expiryInput) }}

        {% if settings.expiryAmount %}
            <p class="notice has-icon">
                <span class="icon" aria-hidden="true"></span>
                <span class="visually-hidden">{{ "Notice:"|t('app') }} </span>
                <span>{{ "NIST 800-63B and OWASP ASVS recommend against periodic password changes. PCI-DSS v4.0 requires 90-day rotation ({link}). If your organization must comply with both, document the conflict in your security policy."|t('password-policy', {
                    link: tag('a', { class: 'go', href: 'https://docs.pcisecuritystandards.org/PCI%20DSS/Standard/PCI-DSS-v4_0_1.pdf', target: '_blank', text: 'Req 8.3.9'|t('password-policy') }),
                })|raw }}</span>
            </p>
        {% endif %}

        <hr>

        {{ forms.textField({
            label: 'Expiry reminder days'|t('password-policy'),
            instructions: "How many days before expiry to send a reminder email."|t('password-policy'),
            name: 'settings[expiryReminderDays]',
            value: settings.expiryReminderDays,
            size: 4,
            type: 'number',
            disabled: readOnly,
        }) }}

        {% if isPro %}
            <hr>

            {% set notificationLogInfo %}
                <span class="info">{{ "Records the expiry reminder emails sent to users — used to deduplicate so the same reminder isn't sent twice within this window."|t('password-policy') }}</span>
            {% endset %}

            {{ forms.textField({
                label: 'Notification log retention (days)'|t('password-policy'),
                instructions: "How long to keep notification log entries before garbage collection prunes them."|t('password-policy') ~ notificationLogInfo,
                name: 'settings[notificationLogRetentionDays]',
                value: settings.notificationLogRetentionDays,
                size: 4,
                type: 'number',
                min: 1,
                disabled: readOnly,
            }) }}
        {% endif %}
    </div>
{% endblock %}
