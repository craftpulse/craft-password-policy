{% requirePermission "pp:settings" %}

{% extends "password-policy/_layouts/password-policy-cp-settings.twig" %}
{% import '_includes/forms.twig' as forms %}

{# Compliance Presets is a Pro-only screen: the settings sidebar omits it
   below Pro and `SettingsController::actionEdit()` denies direct access, so
   this template only ever renders on Pro+. #}
{% set selectedItem = 'presets' %}
{% set title = 'Compliance Presets'|t('password-policy') %}

{# No persistent save button — each preset has its own apply form. #}
{% block actionButton %}{% endblock %}

{% block content %}
    {% set presets = [
        { value: 'nist_800_63b', label: 'NIST 800-63B',
          summary: '15-char minimum, no composition rules, no rotation, HIBP + common-password blocklist enabled. Tracks NIST SP 800-63B Rev. 4.'|t('password-policy') },
        { value: 'owasp_asvs', label: 'OWASP ASVS L1',
          summary: '12-char minimum, max 128, no composition rules, HIBP enabled. Tracks OWASP ASVS Level 1.'|t('password-policy') },
        { value: 'pci_dss_v4', label: 'PCI-DSS v4.0',
          summary: '12-char minimum with case + digit composition, last-4 history, HIBP, 90-day rotation. Satisfies Req 8.3.5–8.3.9.'|t('password-policy') },
        { value: 'cis_controls_v8', label: 'CIS Controls v8',
          summary: '14-char minimum (Safeguard 5.2 password-only floor), last-5 history, HIBP + common-password blocklist, 365-day rotation. Conflicts with NIST on rotation — pick deliberately.'|t('password-policy') },
        { value: 'strict_enterprise', label: 'Strict Enterprise',
          summary: 'Maximum enforcement: composition, history, HIBP fail-closed, 90-day rotation, plus sequential / repeated / contextual character checks.'|t('password-policy') },
    ] %}

    <blockquote class="note tip">
        <p>{{ 'Applies a compliance-aligned password policy to your global settings in one click. Use {groupsLink} for per-group named policies.'|t('password-policy', {
            groupsLink: tag('a', { href: cpUrl('password-policy/settings/groups'), text: 'Group Policies'|t('password-policy') }),
        })|raw }}</p>
        <p><small>{{ "Applying a preset overwrites the global policy fields listed in its summary. Other settings (CSP nonce, strength indicator, retention, audit logging) are untouched."|t('password-policy') }}</small></p>
    </blockquote>

    <table class="data fullwidth">
        <thead>
            <tr>
                <th>{{ 'Preset'|t('password-policy') }}</th>
                <th>{{ 'Summary'|t('password-policy') }}</th>
                <th>{{ 'Action'|t('app') }}</th>
            </tr>
        </thead>
        <tbody>
            {% for preset in presets %}
                <tr>
                    <td>
                        <strong>{{ preset.label }}</strong>
                    </td>
                    <td>{{ preset.summary }}</td>
                    <td>
                        {% if readOnly %}
                            <button type="button" class="btn" disabled>{{ 'Apply'|t('app') }}</button>
                        {% else %}
                            <form method="post" accept-charset="UTF-8" style="display: inline;">
                                {{ csrfInput() }}
                                {{ redirectInput('password-policy/settings/presets') }}
                                <input type="hidden" name="action" value="password-policy/settings/apply-preset">
                                <input type="hidden" name="preset" value="{{ preset.value }}">
                                <button type="submit" class="btn submit">{{ 'Apply'|t('app') }}</button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
