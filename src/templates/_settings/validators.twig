{% requirePermission "pp:settings" %}

{% extends "password-policy/_layouts/password-policy-cp-settings.twig" %}
{% import '_includes/forms.twig' as forms %}

{% set selectedItem = 'validators' %}
{% set title = 'Advanced Validators'|t('password-policy') %}
{% set editionLocked = not isPro %}

{% block actionButton %}
    {% if not readOnly and not editionLocked %}
        <input type="submit" class="btn submit" value="{{ 'Save'|t('app') }}">
    {% endif %}
{% endblock %}

{% block content %}
    <input type="hidden" name="action" value="password-policy/settings/save">
    <input type="hidden" name="pluginHandle" value="password-policy">
    {{ redirectInput('password-policy/settings/validators') }}

    {% if editionLocked %}
        {% include "password-policy/_components/edition-gate" with { edition: 'Pro' } %}
    {% endif %}

    <div class="flex-fields">
        {% set sequentialInfo %}
            <span class="info">{{ "Detects alphabetical sequences (abc, xyz), numeric sequences (123, 987), and keyboard row sequences (qwerty, asdf). Also catches less obvious ASCII sequences like pqr or stu. Both ascending and descending sequences of 3+ characters are blocked."|t('password-policy') }}</span>
        {% endset %}
        {{ forms.lightswitchField({
            label: 'Block sequential characters'|t('password-policy'),
            instructions: "Reject passwords with 3+ sequential characters."|t('password-policy') ~ sequentialInfo,
            name: 'settings[checkSequentialChars]',
            on: settings.checkSequentialChars,
            disabled: readOnly or editionLocked,
        }) }}

        {% set repeatedInfo %}
            <span class="info">{{ "Rejects passwords containing the same character 3 or more times in a row (aaa, 111, !!!). Repeated characters dramatically reduce the effective entropy of a password."|t('password-policy') }}</span>
        {% endset %}
        {{ forms.lightswitchField({
            label: 'Block repeated characters'|t('password-policy'),
            instructions: "Reject passwords with 3+ repeated characters in a row."|t('password-policy') ~ repeatedInfo,
            name: 'settings[checkRepeatedChars]',
            on: settings.checkRepeatedChars,
            disabled: readOnly or editionLocked,
        }) }}

        {% set contextualInfo %}
            <span class="info">{{ "Compares the password against the user's username, email address, first name, last name, and the site name. Matching is case-insensitive. Prevents the most common form of weak passwords in organizational contexts."|t('password-policy') }}</span>
        {% endset %}
        {{ forms.lightswitchField({
            label: 'Block contextual passwords'|t('password-policy'),
            instructions: "Reject passwords containing personal or site-related information."|t('password-policy') ~ contextualInfo,
            name: 'settings[checkContextual]',
            on: settings.checkContextual,
            disabled: readOnly or editionLocked,
        }) }}

        {% set commonInfo %}
            <span class="info">{{ "Checks against a curated blocklist stored locally in your database — no external API calls. If the blocklist is empty when enabled, it will be automatically seeded from the bundled data file via a background job. Manage the blocklist from the Blocklist subnav under Password Policy."|t('password-policy') }}</span>
        {% endset %}
        {{ forms.lightswitchField({
            label: 'Block common passwords'|t('password-policy'),
            instructions: "Reject passwords found in the common password blocklist."|t('password-policy') ~ commonInfo,
            name: 'settings[checkCommonPasswords]',
            on: settings.checkCommonPasswords,
            disabled: readOnly or editionLocked,
        }) }}
    </div>
{% endblock %}
