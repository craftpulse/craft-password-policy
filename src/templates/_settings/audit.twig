{% requirePermission "pp:settings" %}

{% extends "password-policy/_layouts/password-policy-cp-settings.twig" %}
{% import '_includes/forms.twig' as forms %}

{% set selectedItem = 'audit' %}
{% set title = 'Audit Logging'|t('password-policy') %}

{# Audit CAPTURE (enable + retention) is universal across editions. Only the
   admin-alert EXPOSURE field below is Enterprise-gated — as are the compliance
   dashboard, exports, and SIEM/webhook forwarding (gated on their own pages). #}
{% set adminAlertsLocked = not isEnterprise %}

{% block actionButton %}
    {% if not readOnly %}
        <input type="submit" class="btn submit" value="{{ 'Save'|t('app') }}">
    {% endif %}
{% endblock %}

{% block content %}
    <input type="hidden" name="action" value="password-policy/settings/save">
    <input type="hidden" name="pluginHandle" value="password-policy">
    {{ redirectInput('password-policy/settings/audit') }}

    <div class="flex-fields">
        {{ forms.lightswitchField({
            label: 'Enable audit logging'|t('password-policy'),
            instructions: "Record password-related security events to the hash-chained audit log. Captured on every edition; the compliance dashboard, exports, and SIEM/webhook forwarding that read this trail require Enterprise."|t('password-policy'),
            name: 'settings[enableAuditLog]',
            on: settings.enableAuditLog,
            disabled: readOnly,
        }) }}

        {{ forms.textField({
            label: 'Audit log retention (days)'|t('password-policy'),
            instructions: "How long to keep audit log entries. Pruning runs via the recommended `password-policy/gc/run` cron (see documentation)."|t('password-policy'),
            name: 'settings[auditLogRetentionDays]',
            value: settings.auditLogRetentionDays,
            size: 5,
            type: 'number',
            disabled: readOnly,
        }) }}

        <hr>

        {% if adminAlertsLocked %}
            {% include "password-policy/_components/edition-gate" with { edition: 'Enterprise' } %}
        {% endif %}

        {{ forms.autosuggestField({
            label: 'Admin alert email'|t('password-policy'),
            instructions: "Email address for security alerts (lockouts, breach detections). Supports environment variables."|t('password-policy'),
            name: 'settings[adminAlertEmail]',
            suggestEnvVars: true,
            value: settings.adminAlertEmail,
            disabled: readOnly or adminAlertsLocked,
        }) }}

        <hr>

        {{ forms.lightswitchField({
            label: 'Enable IP geolocation'|t('password-policy'),
            instructions: "Resolve the country of each audit event's IP address and store it alongside the entry. Only the country code is stored — never the raw IP. Off by default for data minimisation."|t('password-policy'),
            name: 'settings[geoIpEnabled]',
            on: settings.geoIpEnabled,
            disabled: readOnly or adminAlertsLocked,
        }) }}

        <blockquote class="note tip">
            <p>
                {{ "Geolocation uses the bundled DB-IP Lite database — country-level only, no external API calls or downloads required. IP Geolocation by DB-IP (https://db-ip.com), licensed under CC BY 4.0."|t('password-policy') }}
            </p>
        </blockquote>
    </div>
{% endblock %}
