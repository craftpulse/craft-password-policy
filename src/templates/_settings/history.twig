{% requirePermission "pp:settings" %}

{% extends "password-policy/_layouts/password-policy-cp-settings.twig" %}
{% import '_includes/forms.twig' as forms %}

{% set selectedItem = 'history' %}
{% set title = 'Password History'|t('password-policy') %}

{% block actionButton %}
    {% if not readOnly %}
        <input type="submit" class="btn submit" value="{{ 'Save'|t('app') }}">
    {% endif %}
{% endblock %}

{% block content %}
    <input type="hidden" name="action" value="password-policy/settings/save">
    <input type="hidden" name="pluginHandle" value="password-policy">
    {{ redirectInput('password-policy/settings/history') }}

    <div class="flex-fields">
        {% set historyCountInfo %}
            <span class="info">{{ "Stores bcrypt hashes of previous passwords. When a user changes their password, it is checked against the last N hashes. PCI-DSS v4.0 (Req 8.3.7) requires at least 4. Enterprise security teams typically use 5–12. Per-group history overrides require the Pro edition."|t('password-policy') }}</span>
        {% endset %}
        {{ forms.textField({
            label: 'Password history count'|t('password-policy'),
            instructions: "How many previous passwords to remember. Set to 0 to disable."|t('password-policy') ~ historyCountInfo,
            name: 'settings[passwordHistoryCount]',
            value: settings.passwordHistoryCount,
            size: 3,
            type: 'number',
            min: 0,
            max: 24,
            disabled: readOnly,
        }) }}

        {% set retentionDaysInfo %}
            <span class="info">{{ "Controls how long password hashes are kept for GDPR data minimization. The history count always takes priority — old entries are only purged if the user already has enough newer entries to maintain the count. This prevents TTL-based deletion from undermining the reuse check."|t('password-policy') }}</span>
        {% endset %}
        {{ forms.textField({
            label: 'History retention (days)'|t('password-policy'),
            instructions: "Maximum age for stored password hashes."|t('password-policy') ~ retentionDaysInfo,
            name: 'settings[passwordHistoryExpiryDays]',
            value: settings.passwordHistoryExpiryDays,
            size: 5,
            type: 'number',
            min: 1,
            disabled: readOnly,
        }) }}
    </div>
{% endblock %}
