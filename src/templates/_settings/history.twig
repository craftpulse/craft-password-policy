{% requirePermission "pp:settings" %}

{% extends "password-policy/_layouts/password-policy-cp-settings.twig" %}
{% import '_includes/forms.twig' as forms %}

{% set selectedItem = 'history' %}
{% set title = 'Password History'|t('password-policy') %}
{% set editionLocked = not isPro %}

{% block actionButton %}
    {% if not readOnly and not editionLocked %}
        <input type="submit" class="btn submit" value="{{ 'Save'|t('app') }}">
    {% endif %}
{% endblock %}

{% block content %}
    <input type="hidden" name="action" value="password-policy/settings/save">
    <input type="hidden" name="pluginHandle" value="password-policy">
    {{ redirectInput('password-policy/settings/history') }}

    {% if editionLocked %}
        {% include "password-policy/_components/edition-gate" with { edition: 'Pro' } %}
    {% endif %}

    <div class="flex-fields">
        {{ forms.textField({
            label: 'Password history count'|t('password-policy'),
            instructions: "How many previous passwords to remember. Users cannot reuse any of their last N passwords. Set to 0 to disable. PCI-DSS requires at least 4, most organizations use 5–12."|t('password-policy'),
            name: 'settings[passwordHistoryCount]',
            value: settings.passwordHistoryCount,
            size: 3,
            type: 'number',
            min: 0,
            max: 24,
            disabled: readOnly or editionLocked,
        }) }}

        {{ forms.textField({
            label: 'History retention (days)'|t('password-policy'),
            instructions: "Maximum age for stored password hashes. The history count is always respected — old entries are only deleted if the user has enough newer entries to maintain the count. This setting handles GDPR data minimization for overflow entries, not active reuse prevention."|t('password-policy'),
            name: 'settings[passwordHistoryExpiryDays]',
            value: settings.passwordHistoryExpiryDays,
            size: 5,
            type: 'number',
            min: 1,
            disabled: readOnly or editionLocked,
        }) }}
    </div>
{% endblock %}
