{# SIEM forwarders — Enterprise CP index. Lists every registered
   forwarder with circuit-breaker status pills + per-row send-test +
   reset-circuit affordances. Edition-gated upstream — by the time the
   route resolves the controller has already enforced Enterprise. #}
{# @var forwarders \craftpulse\passwordpolicy\models\SiemForwarderModel[] #}
{# @var readOnly bool #}
{# @var sweepHealth array{stale: bool, unattemptedCount: int, oldestAge: string|null} #}

{% requirePermission "pp:siem-manage" %}

{% extends "password-policy/_layouts/password-policy-cp.twig" %}
{% import '_includes/forms.twig' as forms %}

{% set selectedSubnavItem = 'siem-forwarders' %}
{% set title = 'SIEM forwarders'|t('password-policy') %}
{% set pluginName = 'Password Policy' %}
{% set docTitle = "#{pluginName} - #{title}" %}
{% set crumbs = [
    { label: pluginName, url: cpUrl('password-policy') },
] %}

{% block actionButton %}
    {% if not readOnly %}
        <a href="{{ cpUrl('password-policy/siem/new') }}" class="btn submit add icon">
            {{ 'New forwarder'|t('password-policy') }}
        </a>
    {% endif %}
{% endblock %}

{% block content %}
    {% if readOnly %}
        {{ readOnlyNotice() }}
    {% endif %}

    {# The sweep that forwards audit rows is scheduled by the operator, so
       an install that never wired the cron entry up looks exactly like a
       healthy one from here: an enabled forwarder, a closed circuit, and
       nothing delivered. This is the only place that says so. The verdict
       is computed in `ComplianceAggregateService::getSiemSweepHealth()`,
       which stays quiet on an idle install and on a backlog that has a
       delivery-side cause (that one shows in the Circuit column below). #}
    {% if sweepHealth.stale ?? false %}
        <blockquote class="note warning">
            <p>
                <strong>{{ 'Audit rows are not being forwarded.'|t('password-policy') }}</strong>
                {{ "{n, plural, =1{One audit row has} other{# audit rows have}} been waiting for a first forward attempt, the oldest for {age}."|t('password-policy', {
                    n: sweepHealth.unattemptedCount,
                    age: sweepHealth.oldestAge,
                }) }}
            </p>
            <p>
                {{ 'Forwarding only runs when you schedule it, so this usually means the sweep is missing from cron. Every five minutes is the documented cadence:'|t('password-policy') }}
                <code>php craft password-policy/siem/run</code>
            </p>
            <p>
                {{ 'A queue runner also has to be draining the queue: the command enqueues the forward job, it does not deliver by itself.'|t('password-policy') }}
            </p>
        </blockquote>
    {% endif %}

    <div class="readable">
        <p>
            {{ "Audit-log rows are forwarded to every active SIEM destination, as an RFC 5424 message over syslog-TLS or as a JSON POST over HTTPS. Forwarder failures never block the originating audit write; the queue retries unforwarded rows on the next pass."|t('password-policy') }}
        </p>
    </div>

    {% if forwarders|length == 0 %}
        <blockquote class="note tip">
            <p>
                <strong>{{ 'No forwarders yet.'|t('password-policy') }}</strong>
                {{ 'Click "New forwarder" to register a syslog receiver or an HTTPS collector.'|t('password-policy') }}
            </p>
        </blockquote>
    {% else %}
        <div class="tableview">
            <table class="data fullwidth collapsible">
                <thead>
                    <tr>
                        <th scope="col">{{ 'Name'|t('app') }}</th>
                        <th scope="col">{{ 'Endpoint'|t('password-policy') }}</th>
                        <th scope="col">{{ 'Protocol'|t('password-policy') }}</th>
                        <th scope="col">{{ 'Status'|t('app') }}</th>
                        <th scope="col">{{ 'Circuit'|t('password-policy') }}</th>
                        <th scope="col" class="thin"></th>
                    </tr>
                </thead>
                <tbody>
                    {% for forwarder in forwarders %}
                        {% set editUrl = cpUrl("password-policy/siem/#{forwarder.id}") %}

                        <tr>
                            <td>
                                <a href="{{ editUrl }}">{{ forwarder.displayName }}</a>
                            </td>
                            {# `host:port` on the syslog transport, the URL on
                               the HTTP one — one rule, on the model. #}
                            <td class="code">{{ forwarder.endpointLabel }}</td>
                            <td>{{ forwarder.protocol }}</td>
                            {# Routes through `SiemForwarderModel::getEnabledLabelHtml()`
                               and `getCircuitLabelHtml()` so the pills match Craft's
                               native Status column shape via `Cp::statusLabelHtml()`. #}
                            <td>{{ forwarder.enabledLabelHtml|raw }}</td>
                            <td>{{ forwarder.circuitLabelHtml|raw }}</td>
                            <td class="thin">
                                <a href="{{ editUrl }}" class="btn small" data-icon="edit">
                                    {{ 'Edit'|t('app') }}
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
