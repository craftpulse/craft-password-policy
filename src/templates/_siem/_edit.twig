{# SIEM forwarder edit — content template for asCpScreen() #}
{# @var forwarder \craftpulse\passwordpolicy\models\SiemForwarderModel #}
{# @var isNew bool #}
{# @var readOnly bool #}

{% import '_includes/forms.twig' as forms %}

{% if not isNew %}
    {{ hiddenInput('forwarderId', forwarder.id) }}
{% endif %}

{# The protocol select toggles the two destination groups below. Class-based
   `targetPrefix` (leading dot, per `_components/fieldtypes/Date/settings.twig`)
   rather than an id, because each transport owns more than one group and an
   id can only match once. #}
{% set syslogClass = 'pp-protocol-syslog-tls' ~ (forwarder.isHttp ? ' hidden' : '') %}
{% set httpClass = 'pp-protocol-http' ~ (forwarder.isHttp ? '' : ' hidden') %}

{# =========================================================================
   General — name, protocol, enabled
   ========================================================================= #}

<div id="general">
    {{ forms.textField({
        first: true,
        label: 'Name'|t('app'),
        instructions: 'Optional display label. Defaults to the destination when empty.'|t('password-policy'),
        id: 'name',
        name: 'name',
        value: forwarder.name,
        autofocus: true,
        errors: forwarder.getErrors('name'),
        disabled: readOnly,
    }) }}

    {{ forms.selectField({
        label: 'Protocol'|t('password-policy'),
        instructions: 'Syslog over TLS reaches a collector you run. HTTP POSTs each audit row to an HTTPS collector, for a platform that only ingests over HTTPS.'|t('password-policy'),
        id: 'protocol',
        name: 'protocol',
        options: [
            { label: 'Syslog over TLS'|t('password-policy'), value: 'syslog-tls' },
            { label: 'HTTP'|t('password-policy'), value: 'http' },
        ],
        value: forwarder.protocol,
        toggle: true,
        targetPrefix: '.pp-protocol-',
        errors: forwarder.getErrors('protocol'),
        disabled: readOnly,
    }) }}

    {{ forms.lightswitchField({
        label: 'Enabled'|t('app'),
        instructions: 'Disabled forwarders are skipped by the queue job entirely. Distinct from circuit-open, which is automatic and self-recovering.'|t('password-policy'),
        id: 'enabled',
        name: 'enabled',
        on: forwarder.enabled,
        disabled: readOnly,
    }) }}
</div>

<hr>

{# =========================================================================
   Destination — syslog address + framing, or HTTPS URL + credentials
   ========================================================================= #}

<div id="destination">
    <h2>{{ 'Destination'|t('password-policy') }}</h2>

    <div class="{{ syslogClass }}">
        {{ forms.textField({
            label: 'Host'|t('password-policy'),
            instructions: 'The receiver’s hostname or IP.'|t('password-policy'),
            id: 'host',
            name: 'host',
            value: forwarder.host,
            required: true,
            errors: forwarder.getErrors('host'),
            disabled: readOnly,
        }) }}

        {{ forms.textField({
            label: 'Port'|t('password-policy'),
            instructions: 'The destination port. Defaults to {default} (RFC 5425 / IANA syslog-over-TLS).'|t('password-policy', { default: 6514 }),
            id: 'port',
            name: 'port',
            type: 'number',
            value: forwarder.port,
            inputAttributes: { style: 'width: 8rem', min: 1, max: 65535 },
            required: true,
            errors: forwarder.getErrors('port'),
            disabled: readOnly,
        }) }}

        {{ forms.selectField({
            label: 'Message framing'|t('password-policy'),
            instructions: 'How each message is delimited on the stream. Octet counting is what RFC 5425 requires of a receiver on port 6514. Choose newline for a receiver that expects line-delimited messages, which is what rsyslog’s imtcp accepts by default.'|t('password-policy'),
            id: 'framing',
            name: 'framing',
            options: [
                { label: 'Octet-counted (RFC 5425)'|t('password-policy'), value: 'octet-counted' },
                { label: 'Newline-delimited'|t('password-policy'), value: 'newline' },
            ],
            value: forwarder.framing,
            errors: forwarder.getErrors('framing'),
            disabled: readOnly,
        }) }}
    </div>

    <div class="{{ httpClass }}">
        {# Instructions go through `Cp::parseMarkdown()`, so inline code is a
           markdown backtick in the translation string. An `{% set %}` capture
           would carry this file's indentation into that markdown and render
           the whole instruction as an indented code block, HTML and all. #}
        {{ forms.autosuggestField({
            label: 'Endpoint URL'|t('password-policy'),
            instructions: 'The collector’s HTTPS URL. Supports env variables (e.g. `$PP_SIEM_URL`). Plain http is refused: the request carries audit rows and, on most destinations, a credential.'|t('password-policy'),
            id: 'url',
            name: 'url',
            value: forwarder.url,
            suggestEnvVars: true,
            required: true,
            errors: forwarder.getErrors('url'),
            disabled: readOnly,
        }) }}

        {{ forms.selectField({
            label: 'Authentication'|t('password-policy'),
            instructions: 'How the request authenticates. Choose None when the credential belongs in the URL or in a vendor-named header below.'|t('password-policy'),
            id: 'authType',
            name: 'authType',
            options: [
                { label: 'None'|t('password-policy'), value: 'none' },
                { label: 'Bearer token'|t('password-policy'), value: 'bearer' },
                { label: 'Basic'|t('password-policy'), value: 'basic' },
            ],
            value: forwarder.authType,
            errors: forwarder.getErrors('authType'),
            disabled: readOnly,
        }) }}

        {# Assignment, not a capture: `{% set x %}…{% endset %}` would indent
           the markdown. Appending the stored-credential sentence this way
           keeps the whole instruction flush-left. #}
        {% set tokenInstructions = 'Sent as the Authorization header. For Basic, enter `user:password`. Encrypted at rest, and never shown again after saving. Supports env variables (e.g. `$PP_SIEM_TOKEN`).'|t('password-policy') %}
        {% if forwarder.hasStoredCredential %}
            {% set tokenInstructions = tokenInstructions ~ ' ' ~ 'A credential is stored. Leave this field empty to keep it.'|t('password-policy') %}
        {% endif %}
        {{ forms.autosuggestField({
            label: 'Credential'|t('password-policy'),
            instructions: tokenInstructions,
            id: 'authToken',
            name: 'authToken',
            value: '',
            suggestEnvVars: true,
            errors: forwarder.getErrors('authToken'),
            disabled: readOnly,
        }) }}

        {% set headerRows = {} %}
        {% for headerName, headerValue in forwarder.headers ?? {} %}
            {% set headerRows = headerRows|merge([{ name: headerName, value: headerValue }]) %}
        {% endfor %}
        {{ forms.editableTableField({
            label: 'Custom headers'|t('password-policy'),
            instructions: 'Extra request headers, for the vendor schemes an authentication type cannot express. Values support env variables. Content-Type is set by the forwarder and cannot be overridden, and Authorization is only available when Authentication is None.'|t('password-policy'),
            name: 'headers',
            id: 'headers',
            cols: {
                name: {
                    heading: 'Name'|t('password-policy'),
                    type: 'singleline',
                    code: true,
                },
                value: {
                    heading: 'Value'|t('password-policy'),
                    type: 'singleline',
                    code: true,
                },
            },
            rows: headerRows,
            errors: forwarder.getErrors('headers'),
            addRowLabel: 'Add a header'|t('password-policy'),
            allowAdd: not readOnly,
            allowDelete: not readOnly,
            allowReorder: false,
            static: readOnly,
        }) }}
    </div>
</div>

<hr>

{# =========================================================================
   TLS — verify (syslog only) + CA bundle (both transports)
   ========================================================================= #}

<div id="tls">
    <h2>{{ 'TLS'|t('password-policy') }}</h2>

    <div class="{{ syslogClass }}">
        {{ forms.lightswitchField({
            label: 'Verify TLS certificate'|t('password-policy'),
            instructions: "Require the receiver's certificate chain to verify against the system trust store (or the bundled CA below). Default on. Turn off only when terminating against a self-signed endpoint that you trust by network path. Applies to the syslog transport only: an HTTP forwarder always verifies, because it carries a credential."|t('password-policy'),
            id: 'tlsCertVerify',
            name: 'tlsCertVerify',
            on: forwarder.tlsCertVerify,
            disabled: readOnly,
        }) }}
    </div>

    {{ forms.autosuggestField({
        label: 'Custom CA bundle path'|t('password-policy'),
        instructions: 'Path to a PEM-format CA bundle for verifying the destination. Supports env variables (e.g. `$PP_SIEM_CA_BUNDLE`). Leave empty to use the system trust store. Honoured by both transports.'|t('password-policy'),
        id: 'tlsCaBundlePath',
        name: 'tlsCaBundlePath',
        value: forwarder.tlsCaBundlePath,
        suggestEnvVars: true,
        errors: forwarder.getErrors('tlsCaBundlePath'),
        disabled: readOnly,
    }) }}
</div>

<hr>

{# =========================================================================
   Eligibility — per-forwarder event-class allowlist override
   ========================================================================= #}

<div id="eligibility">
    <h2>{{ 'Eligibility'|t('password-policy') }}</h2>

    {% set eventClassesValue = forwarder.eventClasses ? forwarder.eventClasses|join(', ') : '' %}
    {{ forms.textField({
        label: 'Event class allowlist'|t('password-policy'),
        instructions: 'Comma-separated list of audit-log streams this forwarder receives. Leave empty to use the global setting (currently: `audit_log`). The only supported stream in this release is `audit_log`; `notification_log` is reserved for a future release.'|t('password-policy'),
        id: 'eventClasses',
        name: 'eventClasses',
        value: eventClassesValue,
        class: 'code',
        autocorrect: false,
        autocapitalize: false,
        disabled: readOnly,
    }) }}
</div>

{# =========================================================================
   Circuit status — visible for non-new forwarders only
   ========================================================================= #}

{% if not isNew %}
    <hr>
    <div id="circuit">
        <h2>{{ 'Circuit breaker'|t('password-policy') }}</h2>

        <div class="readable">
            {% if forwarder.circuitOpenAt is null %}
                <blockquote class="note tip">
                    <p>
                        <strong>{{ 'Circuit closed.'|t('password-policy') }}</strong>
                        {{ 'No consecutive failures recorded; the forwarder is healthy.'|t('password-policy') }}
                    </p>
                </blockquote>
            {% else %}
                <blockquote class="note warning">
                    <p>
                        <strong>{{ 'Circuit open.'|t('password-policy') }}</strong>
                        {{ "{n, plural, =1{One consecutive failure} other{# consecutive failures}} since {since}."|t('password-policy', {
                            n: forwarder.consecutiveFailures,
                            since: forwarder.circuitOpenAt|datetime,
                        }) }}
                        {{ "Forwarder will half-open after the configured cooldown elapses; the next forward attempt is the probe."|t('password-policy') }}
                    </p>
                </blockquote>
            {% endif %}

            {% if not readOnly %}
                <div class="flex">
                    <form method="post" accept-charset="UTF-8">
                        {{ csrfInput() }}
                        {{ redirectInput("password-policy/siem/#{forwarder.id}") }}
                        <input type="hidden" name="action" value="password-policy/siem-forwarder/reset-circuit">
                        <input type="hidden" name="forwarderId" value="{{ forwarder.id }}">
                        <button type="submit" class="btn">{{ 'Reset circuit'|t('password-policy') }}</button>
                    </form>

                    {# Secondary action — the primary "Save" sits at the
                       screen header. Test-send + Reset circuit are both
                       secondary; using `btn submit` (blue) would invert
                       the visual hierarchy. #}
                    <button type="button" class="btn" id="pp-siem-send-test">
                        {{ 'Send test event'|t('password-policy') }}
                    </button>
                </div>
            {% endif %}
        </div>
    </div>

    {% if not readOnly %}
        {% js %}
        (function() {
            var btn = document.getElementById('pp-siem-send-test');
            if (!btn) return;

            btn.addEventListener('click', function() {
                btn.disabled = true;

                var formData = new FormData();
                formData.append(Craft.csrfTokenName, Craft.csrfTokenValue);
                formData.append('forwarderId', {{ forwarder.id|json_encode|raw }});

                fetch(Craft.getActionUrl('password-policy/siem-forwarder/send-test'), {
                    method: 'POST',
                    headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                    body: formData,
                }).then(function(r) { return r.json().then(function(j) { return { ok: r.ok, json: j }; }); })
                  .then(function(payload) {
                      var msg = (payload.json && (payload.json.message || payload.json.error))
                          || {{ "Test event response received."|t('password-policy')|json_encode|raw }};
                      if (payload.ok && payload.json && payload.json.message) {
                          Craft.cp.displayNotice(payload.json.message);
                      } else {
                          Craft.cp.displayError(msg);
                      }
                  })
                  .catch(function() {
                      Craft.cp.displayError({{ "Couldn't send the test event."|t('password-policy')|json_encode|raw }});
                  })
                  .finally(function() { btn.disabled = false; });
            });
        })();
        {% endjs %}
    {% endif %}
{% endif %}
