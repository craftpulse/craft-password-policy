{# Notifications activity — element index for `NotificationLogElement`.
 # Extends Craft's `_layouts/elementindex` so the sources sidebar,
 # status filter, pagination, sort, search, and bulk actions
 # (Resend, Delete, Restore) come from the native element-index
 # plumbing.
 #
 # The page chrome (subnav, breadcrumbs, doc title) layers on top of
 # the standard element-index layout. Stable subnav URL is preserved
 # via `_registerCpUrlRules` →
 # `password-policy/notifications/activity` → this template.
 #
 # @author CraftPulse
 # @since 5.2.0
 #}

{% requirePermission "pp:notification-templates-manage" %}

{% extends "_layouts/elementindex" %}

{% set elementType = 'craftpulse\\passwordpolicy\\elements\\NotificationLogElement' %}
{% set title = 'Notification activity'|t('password-policy') %}
{% set docTitle = title %}
{% set selectedSubnavItem = 'notification-activity' %}

{% set crumbs = [
    { label: 'Password Policy'|t('password-policy'), url: cpUrl('password-policy') },
    { label: 'Notifications'|t('password-policy'), url: cpUrl('password-policy/notifications') },
] %}
