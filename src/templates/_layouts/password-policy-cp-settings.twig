{% extends "password-policy/_layouts/password-policy-cp.twig" %}
{%- set selectedSubnavItem = 'settings' -%}

{%- if readOnly is defined and readOnly -%}
    {%- set contentNotice = readOnlyNotice() -%}
{%- endif -%}

{%- set isPro = craft.app.plugins.getPlugin('password-policy').getIsPro() -%}
{%- set isEnterprise = craft.app.plugins.getPlugin('password-policy').getIsEnterprise() -%}

{%- set navItems = {
    'policy-heading': { heading: 'Policy'|t('password-policy') },
    'configuration': { title: 'Configuration'|t('password-policy') },
    'rules': { title: 'Password Rules'|t('password-policy') },
    'retention': { title: 'Password Retention'|t('password-policy') },
    'pro-heading': { heading: 'Pro'|t('password-policy') },
    'history': { title: 'Password History'|t('password-policy'), badge: not isPro ? 'Pro' : null },
    'validators': { title: 'Advanced Validators'|t('password-policy'), badge: not isPro ? 'Pro' : null },
    'groups': { title: 'Group Policies'|t('password-policy'), badge: not isPro ? 'Pro' : null },
    'enterprise-heading': { heading: 'Enterprise'|t('password-policy') },
    'audit': { title: 'Audit Logging'|t('password-policy'), badge: not isEnterprise ? 'Enterprise' : null },
} -%}

{% if selectedItem is not defined %}
    {% set selectedItem = craft.app.request.getSegment(3) ?? 'configuration' %}
{% endif %}

{% block sidebar %}
    <nav>
        <ul>
            {% for handle, item in navItems %}
                {% if item.heading is defined %}
                    <li class="heading">
                        <span>{{ item.heading }}</span>
                    </li>
                {% else %}
                    <li>
                        <a href="{{ url('password-policy/settings/'~handle) }}" {{ handle == selectedItem ? 'class="sel"' }}>
                            {{ item.title }}
                            {% if item.badge is defined and item.badge %}
                                <span class="status" title="{{ item.badge }}"></span>
                            {% endif %}
                        </a>
                    </li>
                {% endif %}
            {% endfor %}
        </ul>
    </nav>
{% endblock %}
