{% extends "password-policy/_layouts/password-policy-cp.twig" %}
{%- set selectedSubnavItem = 'settings' -%}

{%- if readOnly is defined and readOnly -%}
    {%- set contentNotice = readOnlyNotice() -%}
{%- endif -%}

{# Both flags are resolved in `SettingsController::actionEdit()` and passed
   through `renderTemplate()` (P3-01 — moved out of the layout). The
   fallback `craft.app.plugins.getPlugin(...)` reads stay as a defensive
   default for any future caller that might render this layout without
   the controller injecting the flags. #}
{%- set isPro = isPro ?? craft.app.plugins.getPlugin('password-policy').getIsPro() -%}
{%- set isEnterprise = isEnterprise ?? craft.app.plugins.getPlugin('password-policy').getIsEnterprise() -%}

{%- set navItems = {
    'policy-heading': { heading: 'Policy'|t('password-policy') },
    'configuration': { title: 'Configuration'|t('password-policy') },
    'rules': { title: 'Password Rules'|t('password-policy') },
    'retention': { title: 'Password Retention'|t('password-policy') },
    'history': { title: 'Password History'|t('password-policy') },
    'validation-heading': { heading: 'Validation'|t('password-policy') },
    'validators': { title: 'Validators'|t('password-policy') },
    'groups': { title: 'Group Policies'|t('password-policy'), badge: not isPro ? 'Pro' : null },
    'presets': { title: 'Compliance Presets'|t('password-policy'), badge: not isPro ? 'Pro' : null },
    'monitoring-heading': { heading: 'Monitoring'|t('password-policy') },
    'audit': { title: 'Audit Logging'|t('password-policy'), badge: not isEnterprise ? 'Enterprise' : null },
} -%}

{% if selectedItem is not defined %}
    {% set selectedItem = craft.app.request.getSegment(3) ?? 'configuration' %}
{% endif %}

{% block sidebar %}
    <nav>
        <ul>
            {% for handle, item in navItems %}
                {% if item.heading is defined %}
                    <li class="heading">
                        <span>{{ item.heading }}</span>
                    </li>
                {% else %}
                    <li>
                        <a href="{{ cpUrl('password-policy/settings/'~handle) }}" {{ handle == selectedItem ? 'class="sel"' }}>
                            {{ item.title }}
                            {% if item.badge is defined and item.badge %}
                                &ensp;<span class="badge">{{ item.badge }}</span>
                            {% endif %}
                        </a>
                    </li>
                {% endif %}
            {% endfor %}
        </ul>
    </nav>
{% endblock %}
