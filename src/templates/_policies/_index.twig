{# Policies index — element index for `PolicyElement`. Extends Craft's
 # `_layouts/elementindex` so the sources sidebar, pagination, sort,
 # search, and bulk actions (Delete, Restore) come from the native
 # element-index plumbing.
 #
 # Page chrome (subnav, breadcrumbs, doc title) layers on top of the
 # standard element-index layout. Stable subnav URL is preserved via
 # `_registerCpUrlRules` → `password-policy/policies` → this template
 # via `PolicyController::actionIndex`.
 #
 # The "New policy" action button continues to route through
 # `PolicyController::actionEdit` for the form-bound edit screen. The
 # element index "edit" link points at the same controller via
 # `PolicyElement::cpEditUrl()`.
 #
 # @author CraftPulse
 # @since 5.2.0
 #}

{# @var readOnly bool #}

{% requirePermission "pp:settings" %}

{% extends "_layouts/elementindex" %}

{% set elementType = 'craftpulse\\passwordpolicy\\elements\\PolicyElement' %}
{% set title = 'Policies'|t('password-policy') %}
{% set docTitle = title %}
{% set selectedSubnavItem = 'policies' %}

{% set crumbs = [
    { label: 'Password Policy'|t('password-policy'), url: cpUrl('password-policy') },
] %}

{% if not readOnly %}
    {% set actionButton %}
        <a href="{{ cpUrl('password-policy/policies/new') }}" class="btn submit add icon">{{ "New policy"|t('password-policy') }}</a>
    {% endset %}
{% endif %}
