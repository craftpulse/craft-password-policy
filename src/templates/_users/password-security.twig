{# Password Security — User edit screen content
 #
 # Rendered by `UserSecurityController::actionIndex()` into a CP screen
 # response built with `EditUserTrait::asEditUserScreen()`. The trait
 # owns the page chrome (left nav with Profile / Permissions /
 # Addresses / Password Security, title, breadcrumbs, meta sidebar).
 # This template is content-only — no `extends`, no `block content`.
 #
 # Read-only mode (`allowAdminChanges = false`) keeps the page
 # accessible — read-only data (status, resolved policy) is fine to
 # show — but disables write affordances. The `readOnlyNotice()`
 # banner surfaces the constraint; the force-reset `<button>` carries
 # the `disabled` attribute so the form can't submit even if someone
 # bypasses the visual cue.
 #
 # Variables:
 #   - user (craft\elements\User) — the user being viewed
 #   - policy (craftpulse\passwordpolicy\models\SettingsModel) — resolved policy for this user
 #   - isExpired (bool) — whether the user's password is past expiration
 #   - neverChanged (bool) — whether lastPasswordChangeDate is null
 #   - policySource (string) — 'global' or group name explaining why this policy applies
 #   - notifications (NotificationLogElement[]) — most recent notification entries for this user
 #
 # @author CraftPulse
 # @since 5.2.0
 #}

{% import '_includes/forms.twig' as forms %}

{% set readOnly = not craft.app.config.general.allowAdminChanges %}

{% if readOnly %}
    {{ readOnlyNotice() }}
{% endif %}

<div class="pane">
    <h2>{{ "Password Status"|t('password-policy') }}</h2>

    {# The dot is decorative — the adjacent text carries the meaning, so
       `aria-hidden="true"` keeps screen readers from announcing the colour
       indicator. Meets WCAG SC 1.4.1 — colour is not the sole signal. #}
    {% if neverChanged %}
        <div class="readable">
            <p>
                <span class="status red" aria-hidden="true"></span>
                {{ "This user has never changed their password."|t('password-policy') }}
            </p>
        </div>
    {% elseif isExpired %}
        <div class="readable">
            <p>
                <span class="status red" aria-hidden="true"></span>
                {{ "Password expired."|t('password-policy') }}
                {% if user.lastPasswordChangeDate %}
                    {{ "Last changed: {date}"|t('password-policy', {
                        date: user.lastPasswordChangeDate|date('short'),
                    }) }}
                {% endif %}
            </p>
        </div>
    {% else %}
        <div class="readable">
            <p>
                <span class="status green" aria-hidden="true"></span>
                {{ "Password is current."|t('password-policy') }}
                {% if user.lastPasswordChangeDate %}
                    {{ "Last changed: {date}"|t('password-policy', {
                        date: user.lastPasswordChangeDate|date('short'),
                    }) }}
                {% endif %}
            </p>
        </div>
    {% endif %}

    {% if user.passwordResetRequired %}
        <div class="readable">
            <p>
                <span class="status orange" aria-hidden="true"></span>
                {{ "Password reset has been requested. The user must change their password on next login."|t('password-policy') }}
            </p>
        </div>
    {% endif %}
</div>

<div class="pane" style="margin-top: 24px;">
    <h2>{{ "Active Policy"|t('password-policy') }}</h2>

    <div class="readable">
        <p class="light">
            {{ "Policy source: {source}"|t('password-policy', {
                source: policySource,
            }) }}
        </p>
        <ul>
            <li>{{ "Minimum length: {length}"|t('password-policy', { length: policy.minLength }) }}</li>
            {% if policy.maxLength > 0 %}
                <li>{{ "Maximum length: {length}"|t('password-policy', { length: policy.maxLength }) }}</li>
            {% endif %}
            {% if policy.cases %}
                <li>{{ "Requires mixed case"|t('password-policy') }}</li>
            {% endif %}
            {% if policy.numbers %}
                <li>{{ "Requires numbers"|t('password-policy') }}</li>
            {% endif %}
            {% if policy.symbols %}
                <li>{{ "Requires symbols"|t('password-policy') }}</li>
            {% endif %}
            {% if policy.hibp %}
                <li>{{ "Checked against breached password database"|t('password-policy') }}</li>
            {% endif %}
        </ul>
    </div>
</div>

{% if currentUser.can('pp:force-reset-passwords') and not user.passwordResetRequired %}
    <div class="pane" style="margin-top: 24px;">
        <h2>{{ "Actions"|t('password-policy') }}</h2>

        <form method="post" accept-charset="UTF-8">
            {{ csrfInput() }}
            {{ actionInput('password-policy/retention/force-reset') }}
            {{ hiddenInput('userId', user.id) }}
            {{ redirectInput(craft.app.request.url) }}

            <p class="light">
                {{ "Force this user to change their password on next login."|t('password-policy') }}
            </p>

            <button type="submit" class="btn"{% if readOnly %} disabled{% endif %}>
                {{ "Force Password Reset"|t('password-policy') }}
            </button>
        </form>
    </div>
{% endif %}

{% if currentUser.can('pp:notification-templates-manage') %}
    {% include 'password-policy/_users/_notifications-panel.twig' with {
        user: user,
        rows: notifications ?? [],
    } only %}
{% endif %}
