{# Edition gate — shows upgrade prompt for locked features #}
{# @var edition string The required edition name (Pro, Enterprise) #}

{% set pluginHandle = 'password-policy' %}
{% set upgradeUrl = cpUrl('plugin-store/' ~ pluginHandle) %}

<div class="readable mb-xl">
    <blockquote class="note tip">
        <p>
            {{ "This feature requires the {edition} edition. {link}"|t('password-policy', {
                edition: tag('strong', { text: edition }),
                link: tag('a', { href: upgradeUrl, text: 'Upgrade now'|t('password-policy') ~ ' →' }),
            })|raw }}
        </p>
    </blockquote>
</div>
