{# Webhook endpoints — Enterprise CP index. Lists every registered
   endpoint with circuit-breaker status pills + per-row edit
   affordance. Edition-gated upstream — by the time the route resolves
   the controller has already enforced Enterprise. #}
{# @var endpoints \craftpulse\passwordpolicy\models\WebhookEndpointModel[] #}
{# @var readOnly bool #}
{# @var sweepHealth array{stale: bool, staleEndpointCount: int, oldestAge: string|null} #}

{% requirePermission "pp:webhooks-manage" %}

{% extends "password-policy/_layouts/password-policy-cp.twig" %}
{% import '_includes/forms.twig' as forms %}

{% set selectedSubnavItem = 'webhooks' %}
{% set title = 'Webhooks'|t('password-policy') %}
{% set pluginName = 'Password Policy' %}
{% set docTitle = "#{pluginName} - #{title}" %}
{% set crumbs = [
    { label: pluginName, url: cpUrl('password-policy') },
] %}

{% block actionButton %}
    {% if not readOnly %}
        <a href="{{ cpUrl('password-policy/webhooks/new') }}" class="btn submit add icon">
            {{ 'New endpoint'|t('password-policy') }}
        </a>
    {% endif %}
{% endblock %}

{% block content %}
    {% if readOnly %}
        {{ readOnlyNotice() }}
    {% endif %}

    {# The sweep that delivers audit rows is scheduled by the operator, so
       an install that never wired the cron entry up looks exactly like a
       healthy one from here: an enabled endpoint, a closed circuit, and
       nothing delivered. This is the only place that says so. The verdict
       is computed in `ComplianceAggregateService::getWebhookSweepHealth()`,
       which stays quiet on an idle install and on a backlog that has a
       delivery-side cause (that one shows in the Circuit column below). #}
    {% if sweepHealth.stale ?? false %}
        <blockquote class="note warning">
            <p>
                <strong>{{ 'Audit rows are not being delivered.'|t('password-policy') }}</strong>
                {{ "{n, plural, =1{One enabled endpoint has} other{# enabled endpoints have}} a backlog that has never been dispatched, the oldest row waiting {age}."|t('password-policy', {
                    n: sweepHealth.staleEndpointCount,
                    age: sweepHealth.oldestAge,
                }) }}
            </p>
            <p>
                {{ 'Delivery only runs when you schedule it, so this usually means the sweep is missing from cron. Every five minutes is the documented cadence:'|t('password-policy') }}
                <code>php craft password-policy/webhook/run</code>
            </p>
            <p>
                {{ 'A queue runner also has to be draining the queue: the command enqueues the delivery job, it does not deliver by itself.'|t('password-policy') }}
            </p>
        </blockquote>
    {% endif %}

    <div class="readable">
        <p>
            {{ "Audit-log rows are POSTed to every active webhook endpoint with an HMAC-signed JSON body. Each endpoint is an independent subscriber tracking its own dispatch cursor, so endpoint A's success never marks endpoint B's row delivered."|t('password-policy') }}
        </p>
    </div>

    {% if endpoints|length == 0 %}
        <blockquote class="note tip">
            <p>
                <strong>{{ 'No endpoints yet.'|t('password-policy') }}</strong>
                {{ 'Click "New endpoint" to register a webhook subscriber.'|t('password-policy') }}
            </p>
        </blockquote>
    {% else %}
        <div class="tableview">
            <table class="data fullwidth collapsible">
                <thead>
                    <tr>
                        <th scope="col">{{ 'Name'|t('app') }}</th>
                        <th scope="col">{{ 'URL'|t('password-policy') }}</th>
                        <th scope="col">{{ 'Status'|t('app') }}</th>
                        <th scope="col">{{ 'Circuit'|t('password-policy') }}</th>
                        <th scope="col">{{ 'Last delivered row'|t('password-policy') }}</th>
                        <th scope="col" class="thin"></th>
                    </tr>
                </thead>
                <tbody>
                    {% for endpoint in endpoints %}
                        {% set displayName = endpoint.name ?: endpoint.url %}
                        {% set editUrl = cpUrl("password-policy/webhooks/#{endpoint.id}") %}

                        <tr>
                            <td>
                                <a href="{{ editUrl }}">{{ displayName }}</a>
                            </td>
                            <td class="code">{{ endpoint.url }}</td>
                            {# Routes through `WebhookEndpointModel::getEnabledLabelHtml()`
                               and `getCircuitLabelHtml()` so the pills match Craft's
                               native Status column shape via `Cp::statusLabelHtml()`. #}
                            <td>{{ endpoint.enabledLabelHtml|raw }}</td>
                            <td>{{ endpoint.circuitLabelHtml|raw }}</td>
                            <td class="code">
                                {{ endpoint.lastDeliveredRowId ?? '-' }}
                            </td>
                            <td class="thin">
                                <a href="{{ editUrl }}" class="btn small" data-icon="edit">
                                    {{ 'Edit'|t('app') }}
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
