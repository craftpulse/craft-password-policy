{# ============================================================================
 # Alert activity report (G3) — alert-cooldown fires in the last 24h.
 #
 # @var aggregates  ComplianceAggregateService
 # @var report      string
 #
 # @author    CraftPulse
 # @since     5.2.0
 # =========================================================================== #}

{% extends "_layouts/cp" %}

{% set title = 'Alert activity report'|t('password-policy') %}
{% set fullPageForm = false %}

{% block content %}
    {% set activity = aggregates.getAlertCooldownActivity() %}

    <h1>{{ title }}</h1>

    <p class="info">
        {{ 'Generated:'|t('password-policy') }} {{ now|datetime('long') }}
    </p>

    <h2>{{ 'Last 24 hours'|t('password-policy') }}</h2>

    <p>{{ 'Total fires:'|t('password-policy') }} <strong>{{ activity.last24h }}</strong></p>

    {% if activity.byEventClass|length %}
        <table class="data fullwidth">
            <thead>
                <tr>
                    <th scope="col">{{ 'Event class'|t('password-policy') }}</th>
                    <th scope="col">{{ 'Fires'|t('password-policy') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for eventClass, count in activity.byEventClass %}
                    <tr>
                        <th scope="row"><code>{{ eventClass }}</code></th>
                        <td>{{ count }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <blockquote class="note">
            <p>{{ 'No alert activity in the last 24 hours.'|t('password-policy') }}</p>
        </blockquote>
    {% endif %}

    <p>
        <a href="{{ cpUrl('password-policy/reports/alert-activity/csv') }}" class="btn">
            {{ 'Download as CSV'|t('password-policy') }}
        </a>
    </p>
{% endblock %}
