{
    "name": "craftpulse/craft-password-policy",
    "description": "Password Policy plugin",
    "type": "craft-plugin",
    "version": "5.2.0-alpha.1",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "strong passwords",
        "passwords",
        "security"
    ],
    "support":{
        "email": "support@craft-pulse.com",
        "docs": "https://github.com/craftpulse/craft-password-policy/blob/v5/README.md",
        "issues": "https://github.com/craftpulse/craft-password-policy/issues"
    },
    "license": "proprietary",
    "authors": [
        {
            "name": "CraftPulse",
            "email": "support@craft-pulse.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.2.0",
        "bjeavons/zxcvbn-php": "^1.4",
        "craftcms/cms": "^5.9.15",
        "craftpulse/craft-audit-kit": "^1.1.1",
        "geoip2/geoip2": "^3.0",
        "nesbot/carbon": "^2.0.0",
        "nystudio107/craft-plugin-vite": "^5.0.0"
    },
    "suggest": {
        "craftpulse/craft-auth-kit": "Install Auth Kit (with Warden or Warp) to land every passwordless, SSO, and SCIM event on Password Policy's hash-chained, SIEM-forwarded audit log."
    },
    "require-dev":{
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main",
        "craftpulse/craft-auth-kit": "^1.2.0@dev",
        "yiisoft/yii2-redis": "^2.0",
        "vlucas/phpdotenv": "^5.4.0",
        "pestphp/pest": "^4.6"
    },
    "autoload": {
        "psr-4": {
            "craftpulse\\passwordpolicy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "craftpulse\\passwordpolicy\\tests\\": "tests/"
        }
    },
    "extra": {
        "name": "Password Policy",
        "handle": "password-policy",
        "developer": "CraftPulse",
        "developerUrl": "https://craft-pulse.com",
        "documentationUrl": "https://github.com/craftpulse/craft-password-policy/blob/v5/README.md",
        "changelogUrl": "https://github.com/craftpulse/craft-password-policy/blob/v5/CHANGELOG.md",
        "class": "craftpulse\\passwordpolicy\\PasswordPolicy"
    },
    "scripts": {
        "phpstan": "phpstan --ansi --memory-limit=1G",
        "check-cs": "ecs check --ansi",
        "fix-cs": "ecs check --fix --ansi",
        "pest": "pest --colors=always",
        "test": [
            "@check-cs",
            "@phpstan",
            "@pest"
        ]
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true,
            "pestphp/pest-plugin": true
        }
    }
}
